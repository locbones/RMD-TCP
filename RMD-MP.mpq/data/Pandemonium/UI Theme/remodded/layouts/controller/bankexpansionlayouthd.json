{
    "basedOn": "Controller/BankOriginalLayoutHD.json",
    "type": "BankPanel", "name": "BankExpansionLayout",
    "fields": {
        "rect": "$ConsoleCharLeftPanelRect",
        "defaultWidget": "grid"
    },
    "children": [
        {
            "type": "ClickCatcherWidget", "name": "click_catcher"
        },
        {
            "type": "ImageWidget", "name": "background",
            "fields": {
                "rect": { "x": -280, "y": -170 },
                "filename": "..\\..\\..\\ReMoDDeD\\Panels\\Stash\\StashBG_R"
            }
        },
        {
            "type": "TextBoxWidget", "name": "gold_max",
            "fields": {
                "rect": { "x": 334, "y": 1462, "width": 393, "height": 50 }
            }
        },
        {
            "type": "TextBoxWidget", "name": "gold_amount",
            "fields": {
                "rect": { "x": 432, "y": 1391, "width": 270, "height": 57 },
                "style": "$StyleGoldAmount"
            }
        },
        {
            "type": "ButtonWidget", "name": "gold_withdraw",
            "fields": {
                "rect": { "x": 383, "y": 1393, "width": 317, "height": 46 },
                "focusIndicatorFilename": "Controller/HoverImages/GoldButton_Hover",
                "focusIndicatorOffset": { "x": 0, "y": 0 }
            }
        },
        {
            "type": "InventoryGridWidget", "name": "grid",
            "fields": {
                "rect": { "x": -250, "y": 73 },
                "cellCount": { "x": 16, "y": 13 }
            }
        },
        {
            "type": "DropdownListWidget", "name": "BankPages",
            "fields": {
                "anchor": { "x": 0.05, "y": -0.1 },
                "rect": { "width": 408, "height": 75 },
                "background/rect": { "x": 20, "width": 408, "height": 75 },
                "background/leftCapOffset": "$OptionsDropDownLeftCapOffset2",
                "background/rightCapOffset": "$OptionsDropDownRightCapOffset2",
                "pressedFrame": 1,
                "disabledFrame": 2,
                "hoveredFrame": 3,
                "focusIndicatorFilename": "$OptionsDropDownFocusIndicatorFilename",
                "states": [ "Page 1", "Page 2", "Page 3", "Page 4", "Page 5", "Page 6", "Page 7", "Page 8", "Page 9", "Page 10", "Page 11", "Page 12", "Page 13", "Page 14", "Page 15", "Page 16", "Page 17", "Page 18", "Page 19", "Page 20", "Page 21", "Page 22", "Page 23", "Page 24", "Page 25", "Page 26", "Page 27", "Page 28", "Page 29", "Page 30", "Page 31", "Page 32", "Page 33", "Page 34", "Page 35", "Page 36", "Page 37", "Page 38", "Page 39", "Page 40", "Page 41", "Page 42", "Page 43", "Page 44", "Page 45", "Page 46", "Page 47", "Page 48", "Page 49", "Page 50", "Page 51", "Page 52", "Page 53", "Page 54", "Page 55", "Page 56", "Page 57", "Page 58", "Page 59", "Page 60", "Page 61", "Page 62", "Page 63", "Page 64" ],
                "onUpdateMessage": "BankPanelMessage:SelectPage",
                "text/style": "$StyleSettingsCarousel",
                "text/style": { "pointSize": "$MediumFontSize" },
                "textColor": "$FontColorLightGold",
                "tooltipString": "This allows you to switch between multiple pages of shared stash tabs",
                "tooltipStyle": {
                    "showAfterDelay": true}
            }
        },
        {
            "type": "TabBarWidget", "name": "BankTabs",
            "fields": {
                "rect": { "x": -250, "y": -140 },
                "tabCount": 8,
                "filename": "..\\..\\..\\ReMoDDeD\\Panels\\Stash\\Stash_Tabs7",
                "inactiveFrames": [ 1, 1, 1, 1, 1, 1, 1, 1 ],
                "activeFrames": [ 0, 0, 0, 0, 0, 0, 0, 0 ],
                "disabledFrames": [-1, 1, 1, 1, 1, 1, 1, 1 ],
                "textStrings": [ "@personal", "@shared", "@shared", "@shared", "@shared", "@shared", "@shared", "@shared" ],
                "textStyle": { "pointSize": "$MediumFontSize" },
                "focusIndicatorFilename": "Controller/HoverImages/StashTab_Hover",
                "focusIndicatorOffset": { "x": 0, "y": -6 },
                "activeTextColor": "$TabsActiveTextColor",
                "inactiveTextColor": "$TabsInactiveTextColor",
                "tabSize": { "x": 195, "y": 120 },
                "tabPadding": "$PanelTabPadding",
                "onSwitchTabMessage": "BankPanelMessage:SelectTab",
                "tabLeftIndicatorPosition": "$HalfPanelLeftTabButtonPromptPosition",
                "tabRightIndicatorPosition": "$HalfPanelRightTabButtonPromptPosition",
                "focusOnMouseOver": true
            }
        },
        {
            "type": "ImageWidget", "name": "BackgroundBox",
            "fields": {
                "anchor": { "x": 0.945, "y": -0.09 },
                "filename": "PANEL\\StashSearch"
            },
            "children":
            [
                {
                    "type": "InputTextBoxWidget", "name": "search_input",
                    "fields": {
                        "anchor": { "x": 0.035, "y": 0.1 },
                        "rect": { "width": 400, "height": 34 },
                        "fontType": "Chat",
                        "alwaysAcceptsKeyInput": true,
                        "fontStyle": {
                            "fontColor": { "r": 255, "g": 255, "b": 255, "a": 255 },
                            "pointSize": "$MediumFontSize",
                            "fontFace": "BlizzardGlobal",
                            "alignment": { "h": "left", "v": "center" },
                            "options": { "pipeCharacterBehavior": "handle" }
                            },
                        "backgroundColor": [ 0.05, 0.03, 0.02, 1.0 ],
                        "text/rect": { "x": 20, "width": 380, "height": 50 },
                        "maxStringLength": 15
                    }
                },
                {
                    "type": "TextBoxWidget", "name": "stash_search",
                    "fields": {
                        "anchor": { "x": 0.375, "y": -0.6 },
                        "text": "Search:",
                        "style": {
                            "fontColor": "$CharacterListDetailsColor",
                            "pointSize": "$SmallPanelFontSize",
                            "spacing": "$ReducedSpacing",
                            "dropShadow": "$DefaultDropShadow"
                        }
                    }
                }
            ]
        }
    ]
}
